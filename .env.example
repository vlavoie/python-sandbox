# Grok API Configuration
XAI_API_KEY=your-api-key-here

# Optional: Override default API base URL
# XAI_API_BASE_URL=https://api.x.ai/v1

# Optional: Override model names (defaults: grok-4.20 for both)
# Run 'poetry run python list_models.py' to see all available models
# XAI_CHAT_MODEL=grok-4.20
# XAI_IMAGE_MODEL=grok-4.20
#
# Other available models:
# - grok-4.20-non-reasoning (faster, no reasoning step)
# - grok-4.20-reasoning (default, with reasoning)
# - grok-4.20-multi-agent
# - grok-4.3
