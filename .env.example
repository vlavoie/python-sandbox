# Grok API Configuration
XAI_API_KEY=your-api-key-here

# Optional: Override default API base URL
# XAI_API_BASE_URL=https://api.x.ai/v1

# Optional: Override model names
# Run 'poetry run python list_models.py' to see all available models
# XAI_CHAT_MODEL=grok-4.20
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
#
# Available chat models:
# - grok-4.20 (default, with reasoning + vision)
# - grok-4.20-non-reasoning (faster)
# - grok-4.3
#
# Available image generation models:
# - grok-imagine-image-2.0 (default, recommended)
# - grok-imagine-image
# - grok-imagine-image-quality (higher quality, slower)
